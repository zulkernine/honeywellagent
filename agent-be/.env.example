# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/certagent?retryWrites=true&w=majority
MONGODB_DB_NAME=certagent

# OpenRouter LLM (get key at https://openrouter.ai)
# Supported models: anthropic/claude-3.5-sonnet | openai/gpt-4o | google/gemini-flash-1.5 | z-ai/glm-5.3-flash
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
